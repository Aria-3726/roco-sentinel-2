# Storage (SQLite is the zero-config default)
ROCO_DATABASE_PATH=data/roco_sentinel.db

# Search window and keywords
ROCO_KEYWORDS=Roco Kingdom,ロコキングダム
ROCO_REGIONS=US,GB,DE,FR,ES,IT,JP

# Official / compliant APIs
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=roco-sentinel/3.0 by Aria-3726

# Optional RSS / RSSHub feeds, comma-separated
ROCO_RSS_FEEDS=
